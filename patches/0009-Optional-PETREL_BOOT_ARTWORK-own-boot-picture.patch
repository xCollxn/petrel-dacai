From: xCollxn <81695022+xCollxn@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:42:06 +0100
Subject: [PATCH 09/11] Optional PETREL_BOOT_ARTWORK: own boot picture

---
 petrel/artwork/boot.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/petrel/artwork/boot.py b/petrel/artwork/boot.py
index 2d9c7b5..0846fb4 100644
--- a/petrel/artwork/boot.py
+++ b/petrel/artwork/boot.py
@@ -1,5 +1,6 @@
 """Synchronize Petrel's boot JPEG directly into panel picture slot 0."""
 import hashlib
+import os
 from io import BytesIO
 import logging
 from pathlib import Path
@@ -14,7 +15,9 @@ MAGIC = b'PETBOOT1'
 _attempts = set()
 
 
-def sync(lcd, source=SOURCE, *, force=False):
+def sync(lcd, source=None, *, force=False):
+    # PETREL_BOOT_ARTWORK: own boot picture instead of the bundled one.
+    source = source or os.environ.get("PETREL_BOOT_ARTWORK") or SOURCE
     data = Path(source).read_bytes()
     if len(data) > 32767:
         raise ValueError('Boot JPEG must fit before SRAM address 0x7FFF')
