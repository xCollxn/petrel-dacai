+def dacai_driver():
+    lcd = driver()
+    lcd.__class__ = DacaiDriver
+    lcd.host_baud = dacai.DEFAULT_BAUD
+    lcd._sprites = None
+    lcd._sprite_animations = {}
+    lcd._sprite_mask = 0xFFFF
+    lcd._assets_synced = False
+    return lcd
