From bbda79bcba42233ea55cd0187c602b48927e09fa Mon Sep 17 00:00:00 2001
From: xCollxn <81695022+xCollxn@users.noreply.github.com>
Date: Thu, 12 Nov 2026 00:40:58 +0100
Subject: [PATCH 01/11] DWIN driver: extension points for panel variants

- PICTURE_ID_MAX bounds picture IDs for 0x22/0x25/0x33 (15 on T5UIC1).
- prepare_picture() transforms JPEG bytes before store_sram_as_picture;
  boot and shared artwork use it (unchanged bytes on T5UIC1).
- _after_handshake() runs panel link setup before artwork sync.
- take_response(bare_flash_ack=...) can accept a bare A5 OK Data-Flash
  acknowledgement; off for T5UIC1 (BARE_FLASH_ACK = False).

No behavior change for DWIN T5UIC1 panels.
---
 petrel/artwork/boot.py           |  2 +-
 petrel/artwork/shared.py         |  2 +-
 petrel/hardware/dwin/driver.py   | 26 +++++++++++++++++++-------
 petrel/hardware/dwin/protocol.py | 16 +++++++++++++++-
 tests/test_boot_artwork.py       |  1 +
 tests/test_shared_artwork.py     |  1 +
 6 files changed, 38 insertions(+), 10 deletions(-)

diff --git a/petrel/artwork/boot.py b/petrel/artwork/boot.py
index bfa4fda..2d9c7b5 100644
--- a/petrel/artwork/boot.py
+++ b/petrel/artwork/boot.py
@@ -35,7 +35,7 @@ def sync(lcd, source=SOURCE, *, force=False):
         if lcd.read_flash(ADDRESS, SIZE) != invalid:
             raise RuntimeError('Boot artwork metadata invalidation failed')
     logging.info('Uploading Petrel boot artwork to picture slot 0')
-    lcd.write_sram(0, data)
+    lcd.write_sram(0, lcd.prepare_picture(data))
     lcd.serial.flush()
     time.sleep(.1)
     _attempts.add(record)
