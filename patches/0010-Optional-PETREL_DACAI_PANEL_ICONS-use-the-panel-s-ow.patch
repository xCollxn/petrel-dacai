From: xCollxn <81695022+xCollxn@users.noreply.github.com>
Date: Thu, 12 Nov 2026 01:43:16 +0100
Subject: [PATCH 10/11] Optional PETREL_DACAI_PANEL_ICONS: use the panel's own
 icon files

For a DACAI panel that already holds Petrel's icon library as icon/2.zico
(installed via microSD or FEL): icons and 0x28 animations run natively, no
sprite sheets are uploaded, and the sprite checkpoint is cleared so that
switching back uploads every sheet again.
---
 petrel/hardware/dwin/dacai.py | 39 ++++++++++++++++++++++++++++++-----
 tests/test_dacai_panel.py     | 23 +++++++++++++++++++++
 tools/dacai_artwork.py        | 10 +++++++--
 3 files changed, 65 insertions(+), 7 deletions(-)

diff --git a/petrel/hardware/dwin/dacai.py b/petrel/hardware/dwin/dacai.py
index b0f8075..8f80c99 100644
--- a/petrel/hardware/dwin/dacai.py
+++ b/petrel/hardware/dwin/dacai.py
@@ -35,6 +35,9 @@ UART_CLOCK = 15667200
 DEFAULT_BAUD = 115200
 HOST_BAUDS = (115200, 230400, 460800, 921600)
 PICTURE_SIZE = 0x8000
+# Optional: the panel already holds Petrel's icon library as icon/2.zico (installed
+# via microSD or FEL). Then icons and 0x28 animations run natively, no sprite sheets.
+PANEL_ICONS = os.environ.get('PETREL_DACAI_PANEL_ICONS') == '1'
 
 
 class UnsupportedPanelFeature(RuntimeError):
@@ -269,6 +272,8 @@ class DacaiDriver(T5UIC1Display):
     def _startup_animation_library(self):
         from petrel.artwork import sprites
         from petrel.artwork.resources import ICON_LIBRARY_ID
+        if PANEL_ICONS:
+            return ICON_LIBRARY_ID
         try:
             current = sprites.load()
             if sprites.resident(self, current):
@@ -279,9 +284,29 @@ class DacaiDriver(T5UIC1Display):
         return None  # First install: draw the boot frame without icons.
 
     def _startup_sync_icons(self):
-        # Failures propagate like the DWIN icon-library sync: the panel's own
-        # icon files are not Petrel's, so there is no silent fallback.
-        self.sync_sprites()
+        # Failures propagate like the DWIN icon-library sync: without
+        # PETREL_DACAI_PANEL_ICONS the panel's own icon files are not Petrel's,
+        # so there is no silent fallback.
+        if PANEL_ICONS:
+            self._forget_sprites()
+        else:
+            self.sync_sprites()
+
+    def _forget_sprites(self):
+        """Panel icon files in use: invalidate the sprite checkpoint, so switching
+        back uploads every sheet again (the pictures may have been removed)."""
+        from petrel.artwork import sprites
+        self._assets_synced = False
+        self._sprite_animations.clear()
+        self._sprites = None
+        raw = self.read_flash(sprites.METADATA_ADDRESS, sprites.METADATA_SIZE)
+        if sprites.parse_metadata(raw):
+            blank = bytes(sprites.METADATA_SIZE)
+            self.write_flash(sprites.METADATA_ADDRESS, blank)
+            if self.read_flash(sprites.METADATA_ADDRESS, sprites.METADATA_SIZE) != blank:
+                raise RuntimeError('Sprite metadata invalidation failed')
+            logging.info('Panel icon files in use; sprite checkpoint cleared')
+        self._assets_synced = True
 
     def sync_sprites(self, *, force=False):
         """Upload changed sheets; ``force`` repairs pictures removed by a microSD update.
@@ -321,9 +346,13 @@ class DacaiDriver(T5UIC1Display):
 
     @staticmethod
     def _managed_library(library_id):
-        """Petrel's own library: always drawn from the sprite sheets, never natively."""
+        """Petrel's own library: always drawn from the sprite sheets, never natively.
+
+        With PETREL_DACAI_PANEL_ICONS the panel's icon/2.zico holds Petrel's
+        library, so it is drawn with the native 0x23/0x28 like any other.
+        """
         from petrel.artwork.resources import ICON_LIBRARY_ID
-        return library_id == ICON_LIBRARY_ID
+        return not PANEL_ICONS and library_id == ICON_LIBRARY_ID
 
     def _draw_sprites(self, icons, x, y, background):
         """Copy icons from their sheets in a row; False if any icon is missing.
diff --git a/tests/test_dacai_panel.py b/tests/test_dacai_panel.py
index 28ac472..c011467 100644
--- a/tests/test_dacai_panel.py
+++ b/tests/test_dacai_panel.py
@@ -905,6 +905,29 @@ class OpaqueThumbnailTests(unittest.TestCase):
         self.assertIsInstance(future, Future)
 
 
+class PanelIconTests(unittest.TestCase):
+    def test_panel_icons_skip_sheets_and_clear_checkpoint(self):
+        lcd = dacai_driver()
+        lcd._sprites = {7: (0, 0, 0, 20, 20)}
+        flash = {'raw': sprites.metadata([bytes(range(32))])}
+        lcd.read_flash = lambda address, size: flash['raw']
+        lcd.write_flash = lambda address, data: flash.__setitem__('raw', data)
+        with patch('petrel.hardware.dwin.dacai.PANEL_ICONS', True):
+            self.assertEqual(lcd._startup_animation_library(), ICON_LIBRARY_ID)
+            lcd._startup_sync_icons()
+            self.assertTrue(lcd._assets_synced)
+            self.assertIsNone(lcd._sprites)
+            self.assertEqual(sprites.parse_metadata(flash['raw']), [])
+            # The panel holds Petrel's library: native icons and animations.
+            lcd.show_icon(ICON_LIBRARY_ID, 7, 0, 0)
+            lcd.configure_animation(1, True, ICON_LIBRARY_ID, 7, 8, 0, 0, 10)
+        self.assertEqual([op for op, _ in sent(lcd)], [0x23, 0x28])
+        # Without the switch the same state stays silent (no sheets, no fallback).
+        lcd.show_icon(ICON_LIBRARY_ID, 7, 0, 0)
+        lcd.configure_animation(1, True, ICON_LIBRARY_ID, 7, 8, 0, 0, 10)
+        self.assertEqual([op for op, _ in sent(lcd)], [0x23, 0x28])
+
+
 class DacaiConfigurationTests(unittest.TestCase):
     def test_kconfig_round_trip_and_baud_validation(self):
         from tools.configure import Configuration, collect, defaults, render_env, validate
