# Petrel settings for a DACAI screen (systemd EnvironmentFile syntax, no "export", no ~)
# Copy to ~/.config/Petrel/Petrel.env BEFORE running install.sh.
MOONRAKER_URL=http://127.0.0.1:7125
MOONRAKER_API_KEY=
PETREL_REQUEST_TIMEOUT=5

# Pi 5 with dtparam=uart0=on -> /dev/ttyAMA0 (GPIO14/15)
PETREL_SERIAL_PORT=/dev/ttyAMA0
# Wiring from docs/wiring.md: A=GPIO19, B=GPIO26, button=GPIO13.
# Knob turns the wrong way? Swap the two numbers.
PETREL_ENCODER_PINS="26 19"
PETREL_BUTTON_PIN=13
# Absolute path, replace USER
PETREL_SETTINGS_FILE=/home/USER/.config/Petrel/presets.json
PETREL_POWER_DEVICE=Printer
PETREL_POWER_ON_HOLD_MS=2000
PETREL_EMULATOR=0
PETREL_REMOTE=0

# Optional Petrel extras that would modify printer.cfg - off
PETREL_KLIPPER_BUZZER=0
PETREL_AXIS_TRAVEL=0
PETREL_AUX_UART=0
PETREL_NFC=0

# --- petrel-dacai switches (need the patches) ---
# artwork comes from the SD card, never upload it over UART (strongly recommended)
PETREL_LCD_SD_ASSETS=1
# thumbnails drawn from rectangles (DACAI cannot show SRAM JPEGs)
PETREL_RECT_THUMBNAILS=1
# hide the cut-off project QR code on the Info page
PETREL_HIDE_QR=1
# backlight off while the printer board is unreachable (printer switched off)
PETREL_DARK_WHEN_PRINTER_OFF=1
